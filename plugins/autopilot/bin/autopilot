#!/usr/bin/env bash
usage() {
  echo "usage: autopilot {start|status|note <text>|stop [--now]|dash|register|launcher} [--run <name>]" >&2
  exit 2
}
fail() { echo "$*" >&2; exit 1; }

[ $# -gt 0 ] || usage
cmd=$1
shift
run_name=
now=
once=
to=
words=()
while [ $# -gt 0 ]; do
  case $1 in
    --run) [ $# -ge 2 ] || usage; run_name=$2; shift 2 ;;
    --now) if [ "$cmd" = stop ]; then now=1; else words+=("$1"); fi; shift ;;
    --once) if [ "$cmd" = note ]; then once=1; else words+=("$1"); fi; shift ;;
    --to) if [ "$cmd" = note ] && [ $# -ge 2 ]; then to=$2; shift 2; else words+=("$1"); shift; fi ;;
    *) words+=("$1"); shift ;;
  esac
done
case $cmd in
  start | status | note | stop | dash | register | launcher) ;;
  *) usage ;;
esac
bin=$(dirname "$(readlink -f "$0")")
board_of() { # <plan.md>: the board dir, or nothing
  local b
  b=$(sed -n 's/^board:[[:space:]]*//;T;s/[[:space:]]*$//;p' "$1" 2>/dev/null | head -1)
  case $b in none | '') return ;; \~/*) b=$HOME/${b#\~/} ;; esac
  [ -d "$b" ] && echo "${b%/}"
}

if [ "$cmd" = dash ]; then
  if [ ! -t 0 ] || [ ! -t 1 ]; then fail "run autopilot dash in a terminal"; fi
  command -v uv >/dev/null || fail "autopilot dash needs uv: https://docs.astral.sh/uv/"
  AP_PATH=$PATH AP_BIN="$bin/autopilot" exec uv run --script "$bin/../dash/main.py"
fi
if [ "$cmd" = launcher ]; then
  dest=$HOME/.local/bin/autopilot
  install -D -m 755 "$bin/autopilot-launcher" "$dest" || fail "could not install $dest"
  echo "installed $dest"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "warning: $HOME/.local/bin is not on PATH" >&2 ;; esac
  exit 0
fi

repo=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a git repository"
sess=autopilot-$(basename "$repo" | tr '.:' '__')
target="=$sess"
attach="tmux attach -t '$target'"
cd "$repo" || exit 1

register() {
  local conf=$HOME/.config/autopilot
  mkdir -p "$conf" || return 1
  (
    flock 9 || exit 1
    grep -qxF -- "$repo" "$conf/repos" 2>/dev/null || printf '%s\n' "$repo" >> "$conf/repos"
  ) 9> "$conf/repos.lock"
}
if [ "$cmd" = register ]; then
  register || fail "could not register $repo in $HOME/.config/autopilot/repos"
  exit 0
fi

[ -n "$run_name" ] || run_name=$(find .autopilot/runs -mindepth 1 -type d -maxdepth 1 -printf '%f\n' 2>/dev/null | sort -V | tail -1)
[ -n "$run_name" ] || fail "no autopilot run in $repo; run /autopilot plan first"
rel=.autopilot/runs/$run_name
[ -d "$rel" ] || fail "no run $run_name in $repo; run /autopilot plan first"

live() { tmux has-session -t "$target" 2>/dev/null; }
board_dir() { board_of "$rel/plan.md"; }
owner_lines() { awk '/^## Owner[[:space:]]*$/{h=1; next} /^## /{h=0} h && /^- /' "$rel/plan.md"; }

case $cmd in
  note)
    [ ${#words[@]} -gt 0 ] || usage
    ts=$(date -u +%FT%TZ)
    board=
    [ -z "$to" ] || board=$(board_dir)
    if [ -n "$to" ] && [ -z "$board" ]; then fail "no board for this run"; fi
    printf -- '- %s %s%s%s\n' "$ts" "${once:+[once] }" "${to:+[to $to] }" "${words[*]}" >> "$rel/owner.md"
    [ -z "$to" ] || printf -- '- %s owner → %s: %s\n' "$ts" "$to" "${words[*]}" >> "$board/$(basename "$repo").md"
    grep -oE 'item [0-9]+' <<<"${words[*]}" | while read -r _ n; do
      ! grep -qE "^- \[x\] *$n\." "$rel/plan.md" || echo "warning: item $n is already done" >&2
    done
    echo "note $(grep -c '^- ' "$rel/owner.md") added; a waiting run wakes within ~10 s; a running session sees it before its next push or at its next session"
    ;;
  start)
    live && fail "already running in tmux session $sess; watch with: $attach"
    if [ -e "$rel/STOP" ]; then
      rm -f "$rel/STOP"
      echo "removed leftover STOP file"
    fi
    unsets=(-u AUTOPILOT_MODEL -u SLEEP_CMD -u FAKE_SCENARIO -u AUTOPILOT_NO_UPGRADE -u AUTOPILOT_STALL_AFTER -u AUTOPILOT_STALL_EVERY)
    unsets+=(-u AUTOPILOT_RESUME_MODE -u AUTOPILOT_RESUME_REASON -u AUTOPILOT_RESUME_CRASHES)
    while IFS= read -r v; do unsets+=(-u "$v"); done < <(compgen -e | grep '^CLAUDE')
    envs=()
    for v in AUTOPILOT_MODEL CLAUDE_BIN SLEEP_CMD FAKE_SCENARIO AUTOPILOT_NO_UPGRADE AUTOPILOT_STALL_AFTER AUTOPILOT_STALL_EVERY; do
      [ -z "${!v:-}" ] || envs+=(-e "$v=${!v}")
    done
    before=$(wc -l 2>/dev/null < "$rel/runner.log" || echo 0)
    env "${unsets[@]}" \
      tmux new-session -d -s "$sess" -c "$repo" "${envs[@]}" \
      -e "AP_RUNNER=$bin/autopilot-runner" -e "AP_REPO=$repo" -e "AP_REL=$rel" \
      "exec bash \"\$AP_RUNNER\" \"\$AP_REPO\" \"\$AP_REL\"" || fail "tmux could not start session $sess"
    for _ in $(seq 10); do
      live || break
      [ "$(wc -l 2>/dev/null < "$rel/runner.log" || echo 0)" -gt "$before" ] && break
      sleep 0.1
    done
    if ! live && [ "$(wc -l 2>/dev/null < "$rel/runner.log" || echo 0)" -le "$before" ]; then
      fail "the runner exited at once; run it by hand to see why: bash $bin/autopilot-runner $repo $rel"
    fi
    register || echo "warning: could not register $repo for autopilot dash" >&2
    echo "started run $run_name in tmux session $sess; watch with: $attach"
    ;;
  stop)
    live || { echo "nothing is running"; exit 0; }
    if [ -n "$now" ]; then
      echo "$(date -u +%FT%TZ) stop --now by owner" >> "$rel/runner.log"
      tmux kill-session -t "$target"
      echo "killed tmux session $sess"
    else
      touch "$rel/STOP"
      echo "the run stops within ~10 s if waiting, else after the current session"
    fi
    ;;
  status)
    {
    plan=$rel/plan.md
    log=$rel/runner.log
    hv() { sed -n "s/^$1:[[:space:]]*//;T;s/[[:space:]]*\$//;p" "$plan" | head -1; }
    lastl=$(grep -E '^[^ ]+ session=[0-9]+ (start|end) ' "$log" 2>/dev/null | tail -1)
    last=$(sed -nE 's/^[^ ]+ (session=[0-9]+) (start|end) .*/\1/p' <<<"$lastl")
    after=$(awk '/^[^ ]+ session=[0-9]+ (start|end) /{a=""; next} {a = a $0 "\n"} END {printf "%s", a}' "$log" 2>/dev/null)
    stopped=$(sed -nE 's/^[^ ]+ (stopped: .*)/\1/p' <<<"$after" | tail -1)
    if live; then
      state=running
      if [[ $lastl == *" start "* ]]; then
        state="running, ${last/=/ } since ${lastl%% *}"
      elif [[ $lastl =~ \ exit=WAIT\ detail=\"([0-9]+)(\ pid=([0-9,]+))?(\ ack=([A-Za-z0-9_.,-]+))?\" ]] && ! grep -q '^[^ ]* woke ' <<<"$after"; then
        m=${BASH_REMATCH[1]} pids=${BASH_REMATCH[3]} acks=${BASH_REMATCH[5]}
        if [ -n "$acks" ]; then
          state="running, waiting for ack $acks (alert at $(date -u -d "@$(($(date -u -d "${lastl%% *}" +%s) + 10#$m * 60))" +%FT%TZ), from ${last/=/ })"
        else
          state="running, waiting until $(date -u -d "@$(($(date -u -d "${lastl%% *}" +%s) + 10#$m * 60))" +%FT%TZ) (WAIT $m from ${last/=/ }${pids:+, pids $pids})"
        fi
      elif [[ $lastl == *" exit=limit "* ]]; then
        state="running, napping until the usage limit resets"
      fi
    else
      state="not running"
      if [ -n "$last" ]; then
        word=$(sed -nE 's/^[^ ]+ session=[0-9]+ end exit=([A-Za-z]*).*/\1/p' <<<"$lastl")
        case $word in
          killed | crash | limit | nowait) state="not running, ${last/=/ } ended dirty ($word)" ;;
          "") state="not running, ${last/=/ } ended dirty (no end line)" ;;
          *) state="not running, ${last/=/ } ended $word" ;;
        esac
      fi
      [ -z "$stopped" ] || state+="; $stopped"
    fi
    nowid=$(hv now)
    [[ $nowid =~ ^[0-9]+$ ]] || nowid=
    item=
    [ -z "$nowid" ] || item=$(grep -m1 -E "^- \[[^]]*\] *$nowid\." "$plan")
    [ -n "$item" ] || item=$(grep -m1 '^- \[ \]' "$plan")
    item=$(sed -E 's/^- \[[^]]*\] *//' <<<"$item")
    work=$(grep -E '^[^ ]+ session=[0-9]+ end ' "$log" 2>/dev/null | grep -vc ' exit=WAIT ')
    notes=$(grep -c '^- ' "$rel/owner.md" 2>/dev/null)
    echo "run $run_name: $state"
    item=${item:-none}
    echo "now: ${item:0:160}"
    nc=$(grep -c '^- \[c\]' "$plan") np=$(grep -c '^- \[p\]' "$plan")
    cp=
    [ "$((nc + np))" = 0 ] || cp="$nc committed, $np pushed, "
    echo "$(grep -c '^- \[x\]' "$plan") done, $cp$(grep -cE '^- \[!!?\]' "$plan") blocked, $(grep -c '^- \[ \]' "$plan") open · sessions $work/$(hv session-cap) · notes $(hv owner-notes-applied | grep . || echo 0)/${notes:-0}"
    own=$(owner_lines)
    if [ -n "$own" ]; then
      echo "owner: $(wc -l <<<"$own")"
      head -3 <<<"$own" | sed 's/^/  /'
    fi
    echo "handoff:"
    awk '/^## Handoff/{h=1; next} /^## /{h=0} h && NF' "$plan" | head -15
    echo "last session end: $(grep -E '^[^ ]+ session=[0-9]+ end exit=' "$log" 2>/dev/null | tail -1 | cut -d' ' -f2-)"
    board=$(board_dir)
    if [ -n "$board" ]; then
      echo "board:"
      for f in "${board%/}"/*.md; do
        [ -f "$f" ] || continue
        l=$(grep '^- ' "$f" | tail -1)
        l=${l#- }
        echo "  $(basename "$f" .md)  ${l:0:160}"
      done
    fi
    ! live || echo "watch: $attach"
    } | tr -d '\000-\010\013-\037\177'
    ;;
esac

#!/usr/bin/env bash
set -u
export LC_ALL=C.UTF-8
STALL_AFTER=${AUTOPILOT_STALL_AFTER:-3900}
R=$'\033[0m' DIM=$'\033[2m' RED=$'\033[31m' GRN=$'\033[32m' YEL=$'\033[33m'

usage() {
  echo "usage: autopilot-watch [--once --width W --height H] [--sub 0|1] [--think 0|1] [--compact 0|1] <repo> [run]" >&2
  echo "       autopilot-watch board [--once --width W --height H] <board-dir>" >&2
  exit 2
}

clean() { tr -d '\000-\010\013-\037\177'; }
num() { [[ ${1:-} =~ ^[0-9]+$ ]] && echo "$1" || echo 0; }
now_s() { echo "${AUTOPILOT_NOW:-$(date +%s)}"; }
ago() {
  if (($1 < 60)); then echo "<1m"; elif (($1 < 5400)); then echo "$(($1 / 60))m"; else echo "$(($1 / 3600))h"; fi
}
hv() { sed -n "s/^$1:[[:space:]]*//;T;s/[[:space:]]*\$//;p" "$2" 2>/dev/null | head -1; }
pct() { [ -n "$1" ] && awk -v x="$1" 'BEGIN { printf "%d%%", x * 100 }' || echo '?'; }
board_path() {
  local b
  b=$(hv board "$1")
  case $b in none | '') return ;; \~/*) b=$HOME/${b#\~/} ;; esac
  [ -d "$b" ] && echo "${b%/}"
}

render_stream() { # <jsonl> <width> <sub> <think> <compact>
  tail -n 1500 "$1" 2>/dev/null | jq -r --argjson sub "$3" --argjson think "$4" --argjson compact "$5" '
    def clean: tostring | gsub("[\u0000-\u0008\u000b-\u001f\u007f-\u009f]"; "");
    def one: clean | gsub("[\r\t]"; " ") | split("\n")[0];
    select(.type == "assistant" or .type == "user")
    | select($sub == 1 or .parent_tool_use_id == null)
    | (if .parent_tool_use_id then "│ " else "" end) as $p
    | .message.content[]?
    | if .type == "text" and $compact == 0 then (.text | clean | split("\n") | map(select(test("\\S"))) | .[] | "T|\($p)\(gsub("\t"; "  "))")
      elif .type == "thinking" and $think == 1 then "K|\($p)· thinking"
      elif .type == "tool_use" then
        "U|\($p)▸ \(.name) " + ((.input.description // .input.command // .input.file_path // .input.pattern // .input.prompt // .input.url // "") | one)
      elif .type == "tool_result" and .is_error == true then
        "E|\($p)✗ " + ((.content | if type == "array" then map(.text? // "") | join(" ") else . end) | one)
      else empty end' 2>/dev/null |
    awk -v w="$2" '
      { tag = substr($0, 1, 1); s = substr($0, 3) }
      tag == "T" { while (length(s) > w) { print substr(s, 1, w); s = "  " substr(s, w + 1) } print s; next }
      tag == "U" { print "\033[36m" substr(s, 1, w) "\033[0m"; next }
      tag == "E" { print "\033[31m" substr(s, 1, w) "\033[0m"; next }
      tag == "K" { print "\033[2m" substr(s, 1, w) "\033[0m"; next }'
}

count_sub() { tail -n 1500 "$1" 2>/dev/null | jq -c 'select(.parent_tool_use_id != null and (.type == "assistant" or .type == "user"))' 2>/dev/null | wc -l; }

fit() { # <width> <rows>: every line cut to width visible cells, exactly rows lines
  awk -v w="$1" -v rows="$2" '
    function f(s,   out, n) { out = ""; n = 0
      while (length(s) > 0 && n < w) {
        if (match(s, /^\033\[[0-9;?]*[A-Za-z]/)) { out = out substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1) }
        else { out = out substr(s, 1, 1); s = substr(s, 2); n++ } }
      return out "\033[0m" }
    NR <= rows { print f($0) }
    END { for (i = NR + 1; i <= rows; i++) print "" }'
}

open_requests() { # <board-dir>
  awk '
    FNR == 1 { file = FILENAME }
    { line = $0; sub(/^- ([0-9T:-]+Z )?/, "", line) }
    match(line, /^([A-Za-z0-9_.-]+-[0-9]+)( \(replaces ([A-Za-z0-9_.-]+-[0-9]+)\))? → ([^:]+)/, m) {
      post[m[1]] = m[4]; from[m[1]] = file; order[++n] = m[1]
      if (m[3] != "") replaced[m[3]] = 1
    }
    { s = $0; while (match(s, /(ack|nack|reject) ([A-Za-z0-9_.-]+-[0-9]+)/, a)) { ans[a[2]][file] = 1; s = substr(s, RSTART + RLENGTH) } }
    END {
      for (i = 1; i <= n; i++) { id = order[i]; ok = (id in replaced)
        if (id in ans) for (f in ans[id]) if (f != from[id]) ok = 1
        if (!ok) print id " → " post[id] }
    }' "$1"/*.md 2>/dev/null
}

live_session() { env -u TMUX tmux has-session -t "=autopilot-$(basename "$1" | tr '.:' '__')" 2>/dev/null; }

state_of() { # <repo> [run] -> st label stream info[]
  local repo=$1 run=${2:-} rel log plan lastl endl after now age n m t r live=0
  now=$(now_s)
  [ -n "$run" ] || run=$(find "$repo/.autopilot/runs" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -V | tail -1)
  rel=$repo/.autopilot/runs/$run log=$rel/runner.log plan=$rel/plan.md
  live_session "$repo" && live=1
  lastl=$(grep -E '^[^ ]+ session=[0-9]+ (start|end) ' "$log" 2>/dev/null | tail -1)
  endl=$(grep -E '^[^ ]+ session=[0-9]+ end ' "$log" 2>/dev/null | tail -1)
  after=$(awk '/^[^ ]+ session=[0-9]+ (start|end) /{a=""; next} {a = a $0 "\n"} END {printf "%s", a}' "$log" 2>/dev/null)
  n=$(sed -nE 's/^[^ ]+ session=([0-9]+) .*/\1/p' <<<"$lastl")
  stream=$rel/sessions/$n.jsonl
  local ndone blk open nc np own
  own=$(awk '/^## Owner/{h=1; next} /^## /{h=0} h && /^- /' "$plan" 2>/dev/null | wc -l)
  nc=$(grep -c '^- \[c\]' "$plan" 2>/dev/null) np=$(grep -c '^- \[p\]' "$plan" 2>/dev/null)
  ndone=$(grep -c '^- \[x\]' "$plan" 2>/dev/null) blk=$(grep -cE '^- \[!!?\]' "$plan" 2>/dev/null) open=$(grep -c '^- \[ \]' "$plan" 2>/dev/null)
  if [[ $lastl == *" start "* ]] && ((live)); then
    age=$((now - $(stat -c %Y "$stream" 2>/dev/null || echo "$now")))
    if ((age >= STALL_AFTER)); then st=needs label="STALLED $(ago "$age") silent · s$n"
    elif ((age >= 300)); then st=quiet label="QUIET $(ago "$age") · s$n"
    else st=working label="WORKING s$n"; fi
  elif ((live)); then
    st=waiting label=WAITING
    if [[ $lastl =~ \ exit=WAIT\ detail=\"([0-9]+)(\ pid=([0-9,]+))?\" ]] && ! grep -q '^[^ ]* woke ' <<<"$after"; then
      m=${BASH_REMATCH[1]} r=${BASH_REMATCH[3]}
      t=$(($(date -u -d "${lastl%% *}" +%s) + 10#$m * 60 - now))
      label+=" next ≤$(ago $((t > 0 ? t : 0)))${r:+ · pid ${r//,/ }}"
    elif [[ $lastl == *" exit=limit "* ]]; then
      label+=" · usage limit"
    fi
  else
    r=$(sed -nE 's/^[^ ]+ stopped: (.*)/\1/p' <<<"$after" | tail -1 | clean)
    if [ -n "$endl" ] && [ -n "$r" ] && ! [[ $r =~ ^(owner\ needed|two\ crashes|limit|checkpoint|.*no\ valid) ]]; then
      st='done' label="STOPPED: $r"
    else
      st=needs label="STOPPED: ${r:-$(grep -oE 'exit=[a-z]+' <<<"$endl" || echo 'no runner')}"
    fi
  fi
  ((blk == 0)) || { st=needs; label+=" · $blk blocked"; }
  ((own == 0)) || { st=needs; label+=" · owner $own"; }
  label="$(basename "$repo") · $label"

  local item hist ctx br up notes applied weekly five ceil work cap nowv
  nowv=$(hv now "$plan")
  [[ $nowv =~ ^[0-9]+$ ]] || nowv=
  item=
  [ -z "$nowv" ] || item=$(grep -m1 -E "^- \[[^]]*\] *$nowv\." "$plan")
  [ -n "$item" ] || item=$(grep -m1 '^- \[ \]' "$plan" 2>/dev/null)
  item=$(sed -E 's/^- \[[^]]*\] *//; s/[[:space:]]{2,}(after|check|waiting):.*//' <<<"$item" | clean)
  weekly=$(grep -oE 'weekly=[0-9.]+' <<<"$endl" | cut -d= -f2)
  five=$(grep -oE 'five_hour=[0-9.]+' <<<"$endl" | cut -d= -f2)
  ceil=$(hv weekly-ceiling "$plan")
  cap=$(hv session-cap "$plan")
  ctx=$(grep -oE 'peak_ctx=[0-9]+' <<<"$endl" | cut -d= -f2)
  work=$(grep -E '^[^ ]+ session=[0-9]+ end ' "$log" 2>/dev/null | grep -vc ' exit=WAIT ')
  hist=$(grep -E '^[^ ]+ session=[0-9]+ end ' "$log" 2>/dev/null | tail -12 | sed -nE 's/.* exit=([A-Za-z]+).*/\1/p' |
    awk -v g="$GRN" -v r="$RED" -v d="$DIM" -v z="$R" '
      { c = $1 == "NEXT" ? g "N" : $1 == "WAIT" ? d "W" : $1 == "DONE" ? g "D" : $1 == "STOP" ? r "S" : $1 == "limit" ? r "L" : $1 == "killed" ? r "K" : r "✗"
        printf "%s%s ", c, z }')
  br=$(git --no-optional-locks -C "$repo" branch --show-current 2>/dev/null)
  up=$(git --no-optional-locks -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null) && up="+$up unpushed" || up="no upstream"
  applied=$(num "$(hv owner-notes-applied "$plan")")
  notes=$(num "$(grep -c '^- ' "$rel/owner.md" 2>/dev/null)")
  info=(
    "item ${item:-none}"
    "${ndone}✓ ${blk}✗ ${open}○$( ((nc + np > 0)) && echo " ${nc}c ${np}p")  ·  s${n:-0}  ·  work $work/${cap:-?}  ·  wk $(pct "$weekly")/$(pct "$ceil")  ·  5h $(pct "$five")"
    "last ${hist:-none} ·  ctx $((${ctx:-0} / 1000))k"
    "${br:-detached}  ·  $up  ·  notes $applied/$notes$( ((notes > applied)) && echo " (${YEL}$((notes - applied)) pending${R})")$( ((own > 0)) && echo "  ·  ${RED}owner $own${R}")"
  )
}

colors() { case $1 in working) c=32 bg=42 ;; waiting) c=34 bg=44 ;; quiet) c=33 bg=43 ;; needs) c=31 bg=41 ;; *) c=90 bg=100 ;; esac; }

pane_frame() { # <cols> <lines> <focus>; uses body[] total off sub think compact nsub
  local cols=$1 lines=$2 focus=$3 h start flags i l lab
  colors "$st"
  h=$((lines - 6))
  start=$((total - h - off))
  ((start < 0)) && start=0
  flags="sub$( ((sub)) && echo ✓ || echo ✗)($nsub) think$( ((think)) && echo ✓ || echo ✗) compact$( ((compact)) && echo ✓ || echo ✗)"
  ((focus)) && flags="keys: s t x · ↑↓ PgUp/Dn · End  │  $flags"
  ((off > 0)) && flags="↑$off  End=follow  $flags"
  lab=$label
  ((focus)) && lab="◆ $lab"
  {
    printf '\033[%s;30;1m %s%*s\033[0m\n' "$bg" "$lab" "$cols" ''
    info[0]=${info[0]:0:cols-3}
    for l in "${info[@]}"; do printf '\033[%sm▌\033[0m %s\n' "$c" "$l"; done
    printf '\033[%sm▌\033[0m \033[2m%s\033[0m\n' "$c" "$(printf '%*s' $((cols - 3 - ${#flags})) '' | tr ' ' '-') $flags"
    for ((i = start; i < start + h && i < total; i++)); do printf '\033[%sm▌\033[0m %s\n' "$c" "${body[i]}"; done
  } | fit "$cols" "$lines"
}

board_frame() { # <board-dir> <cols> <lines>
  local f line open
  open=$(open_requests "$1" | clean | paste -sd'|' | sed 's/|/   /g')
  {
    printf '\033[1;7m BOARD %s \033[0m  open: \033[33m%s\033[0m\n' "$(basename "$(dirname "$1")")" "${open:-none}"
    for f in "$1"/*.md; do
      [ -f "$f" ] || continue
      line=$(grep '^- ' "$f" | tail -1 | cut -c3- | tr '\t' ' ' | clean)
      printf '\033[1m%-11s\033[0m \033[2m%s\033[0m\n' "$(basename "$f" .md)" "$line"
    done
  } | fit "$2" "$3"
}

draw() { # <frame>: rows cursor-addressed and cleared before writing, skipped when unchanged
  [ "$1" != "${last_frame:-}" ] || return 0
  last_frame=$1
  local out=$'\033[?2026h' i=1 l
  while IFS= read -r l; do out+=$'\033['"$i"$';1H\033[K'"$l"; i=$((i + 1)); done <<<"$1"
  printf '%s\033[?2026l' "$out"
}

screen_on() {
  stty -echo -icanon 2>/dev/null
  printf '\033[?1049h\033[?25l\033[?7l\033[?1004h'
  trap 'printf "\033[?1004l\033[?7h\033[?25h\033[?1049l"; stty sane 2>/dev/null' EXIT
}

once=0 width=100 height=30 sub=1 think=0 compact=0 mode=pane
[ "${1:-}" != board ] || { mode=board; shift; }
while [ $# -gt 0 ]; do
  case $1 in
    --once) once=1; shift ;;
    --width) width=$2; shift 2 ;;
    --height) height=$2; shift 2 ;;
    --sub) sub=$2; shift 2 ;;
    --think) think=$2; shift 2 ;;
    --compact) compact=$2; shift 2 ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || usage

if [ "$mode" = board ]; then
  if ((once)); then board_frame "$1" "$width" "$height"; exit 0; fi
  screen_on
  while :; do
    draw "$(board_frame "$1" "$(tput cols)" "$(tput lines)")"
    sleep 5
  done
fi

repo=$1 run=${2:-}
if ((once)); then
  state_of "$repo" "$run"
  mapfile -t body < <(render_stream "$stream" $((width - 2)) "$sub" "$think" "$compact")
  total=${#body[@]} off=0 nsub=$(count_sub "$stream")
  pane_frame "$width" "$height" 0
  exit 0
fi

screen_on
off=0 total=0 rsig='' prev=0 body=() k='' rest='' nsub=0 focus=0 h=0
while :; do
  cols=$(tput cols) lines=$(tput lines)
  state_of "$repo" "$run"
  [[ $k == $'\033['[IO] ]] || { [ -z "${TMUX_PANE:-}" ] || focus=$(tmux display -p -t "$TMUX_PANE" '#{pane_active}'); }
  sig="$(stat -c %Y:%s "$stream" 2>/dev/null):$stream:$sub$think$compact:$cols"
  if [ "$sig" != "$rsig" ]; then
    prev=$total
    mapfile -t body < <(render_stream "$stream" $((cols - 2)) "$sub" "$think" "$compact")
    total=${#body[@]}
    nsub=$(count_sub "$stream")
    [[ ${rsig#*:*:} == "${sig#*:*:}" ]] && ((off > 0)) && off=$((off + total - prev))
    rsig=$sig
  fi
  h=$((lines - 6))
  ((off > total - h)) && off=$((total - h))
  ((off < 0)) && off=0
  draw "$(pane_frame "$cols" "$lines" "$focus")"
  k=
  read -rsn1 -t 2 k
  if [ "$k" = $'\033' ]; then read -rsn4 -t 0.01 rest; k=$k$rest; fi
  case $k in
    s) sub=$((1 - sub)) ;; t) think=$((1 - think)) ;; x) compact=$((1 - compact)) ;;
    k | $'\033[A') off=$((off + 3)) ;; j | $'\033[B') off=$((off - 3)) ;;
    $'\033[5~') off=$((off + h - 2)) ;; $'\033[6~') off=$((off - h + 2)) ;;
    G | $'\033[F' | $'\033[4~' | $'\033OF') off=0 ;;
    $'\033[I') focus=1 ;; $'\033[O') focus=0 ;;
  esac
done
